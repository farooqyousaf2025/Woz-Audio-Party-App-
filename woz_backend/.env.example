PORT=8090
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/woz
JWT_SECRET=generate-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-an-admin-password
UPLOAD_DIR=uploads
MODELS_DIR=models
# Base URL the admin panel/verification helpers assume when calling the API.
BASE_URL=http://127.0.0.1:8090

# Optional integrations. While these stay unset the server returns generated
# verification codes in the API response, so local flows remain testable.
#SMTP_HOST=
#SMS_PROVIDER=
# Path to the Firebase service-account JSON used by src/push.js (FCM v1 API).
#FCM_SERVICE_ACCOUNT=
# Path to the Google Play service-account JSON used for purchase verification.
#PLAY_SERVICE_ACCOUNT=
