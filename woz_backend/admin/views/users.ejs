<%- include('partials/head', { title: appName + ' - Users' }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>
<div class="page-wrapper">
  <div class="row page-titles">
    <div class="col">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active">All users</li>
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <% if (saved) { %>
      <div class="alert alert-success">User saved.</div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <form method="get" action="/admin/users" class="form-inline m-b-20">
          <input class="form-control m-r-10" type="text" name="q" placeholder="Search username, name or email" value="<%= search %>">
          <button class="btn btn-primary" type="submit">Search</button>
        </form>

        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Username</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Credit</th>
                <th>Diamonds</th>
                <th>Status</th>
                <th>Registered</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function (user) { %>
                <tr>
                  <td><%= user.username %></td>
                  <td><%= user.name || '-' %></td>
                  <td><%= user.email || '-' %></td>
                  <td><%= user.role %></td>
                  <td><%= user.credit %></td>
                  <td><%= user.diamonds %></td>
                  <td>
                    <% if (user.account_deleted) { %>
                      <span class="label label-danger">deleted</span>
                    <% } else if (user.activation_status) { %>
                      <span class="label label-warning">blocked</span>
                    <% } else { %>
                      <span class="label label-success">active</span>
                    <% } %>
                  </td>
                  <td><%= new Date(user.created_at).toLocaleString() %></td>
                  <td><a class="btn btn-sm btn-primary" href="/admin/users/<%= user.object_id %>">Edit</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% var pages = Math.ceil(total / perPage); %>
        <% if (pages > 1) { %>
          <nav>
            <ul class="pagination">
              <% for (var p = 1; p <= pages; p++) { %>
                <li class="page-item <%= p === page ? 'active' : '' %>">
                  <a class="page-link" href="/admin/users?q=<%= encodeURIComponent(search) %>&page=<%= p %>"><%= p %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>
        <p class="text-muted">Total: <%= total %></p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
