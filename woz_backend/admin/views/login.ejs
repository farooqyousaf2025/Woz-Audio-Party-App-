<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= appName %> Dashboard - Login</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/admin/assets/dashboard/images/favicon.ico">
  <link rel="stylesheet" type="text/css" href="/admin/assets/dashboard/css/lib/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" type="text/css" href="/admin/assets/login/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" type="text/css" href="/admin/assets/dashboard/css/animate.css">
  <link rel="stylesheet" type="text/css" href="/admin/assets/login/css/util.css">
  <link rel="stylesheet" type="text/css" href="/admin/assets/login/css/main.css">
</head>
<body>
<div class="limiter">
  <div class="container-login100">
    <div class="wrap-login100">
      <form method="post" action="/admin/login" class="login100-form validate-form">
        <div class="login100-pic js-tilt" data-tilt>
          <img src="/admin/media/logo.png" alt="<%= appName %>">
        </div>
        <span class="login100-form-title">Welcome to <%= appName %> dashboard</span>

        <% if (error) { %>
          <div class="alert alert-danger" style="width:100%;">Invalid admin credentials.</div>
        <% } %>

        <div class="wrap-input100 validate-input" data-validate="Username empty">
          <input class="input100" type="text" name="username" placeholder="Admin username">
          <span class="focus-input100"></span>
          <span class="symbol-input100"><i class="fa fa-user" aria-hidden="true"></i></span>
        </div>

        <div class="wrap-input100 validate-input" data-validate="Password empty">
          <input class="input100" type="password" name="password" placeholder="Admin Password">
          <span class="focus-input100"></span>
          <span class="symbol-input100"><i class="fa fa-lock" aria-hidden="true"></i></span>
        </div>

        <div class="container-login100-form-btn">
          <button class="login100-form-btn" type="submit">Login</button>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/admin/assets/dashboard/js/lib/jquery/jquery.min.js"></script>
<script src="/admin/assets/dashboard/js/popper.min.js"></script>
<script src="/admin/assets/dashboard/js/lib/bootstrap/js/bootstrap.min.js"></script>
</body>
</html>
